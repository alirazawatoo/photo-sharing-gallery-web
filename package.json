{
  "name": "photo-sharing-gallery-web",
  "version": "1.0.0",
  "private": true,
  "description": "React gallery over a fixed, paginated Express image API (refactoring exercise).",
  "keywords": [
    "react",
    "express",
    "gallery",
    "photos"
  ],
  "license": "ISC",
  "engines": {
    "node": "^22.15.0"
  },
  "scripts": {
    "start": "concurrently --kill-others-on-fail --names api,web --prefix-colors cyan,magenta \"npm:start:api\" \"npm:start:web\"",
    "start:api": "node --watch src/do-not-refactor/server.js",
    "start:web": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "jest --runInBand",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.7",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
